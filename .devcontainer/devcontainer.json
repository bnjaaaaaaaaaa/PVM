{
  "name": "PMV Conservación Marina",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.codespaces.yml"],
  "service": "web",
  "runServices": ["db", "web"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "PMV (Streamlit)",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
